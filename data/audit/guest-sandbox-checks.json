    "pythonForkAndThreads": {
      "image": "python",
      "executable": "/usr/local/bin/python",
      "options": [
        "-I",
        "-u",
        "-c"
      ],
      "forkCode": "import errno,json,os,resource\nr,w=os.pipe(); children=[]; failure=None\ntry:\n for index in range(64):\n  try: child=os.fork()\n  except OSError as error:\n   failure={'errno':error.errno,'message':str(error)}; break\n  if child==0:\n   os.close(w); os.read(r,1); os._exit(0)\n  children.append(child)\nfinally:\n os.close(w)\n for child in children: os.waitpid(child,0)\nprint(json.dumps({'nproc':resource.getrlimit(resource.RLIMIT_NPROC),'forked':len(children),'failure':failure}))\n",
      "threadCode": "import json,resource,threading\nevent=threading.Event(); threads=[]; failure=None\ntry:\n for index in range(64):\n  thread=threading.Thread(target=event.wait)\n  try: thread.start()\n  except RuntimeError as error:\n   failure=str(error); break\n  threads.append(thread)\nfinally:\n event.set()\n for thread in threads: thread.join()\nprint(json.dumps({'nproc':resource.getrlimit(resource.RLIMIT_NPROC),'threads':len(threads),'failure':failure}))\n"
    },
    "swiftImagePythonForkAndThreads": {
      "image": "swift",
      "executable": "/usr/bin/python3",
      "options": [
        "-I",
        "-u",
        "-c"
      ],
      "codeReference": "pythonForkAndThreads",
      "note": "Uses Python already installed in the fixed Swift image. Tests guest process limits, not Swift language semantics."
    },
    "cFork": {
      "entrypoint": "/bin/sh",
      "command": "gcc -x c -o /work/fork-limit - && exec /work/fork-limit",
      "stdinSource": "#include <sys/resource.h>\n#include <sys/types.h>\n#include <sys/wait.h>\n#include <unistd.h>\n#include <errno.h>\n#include <stdio.h>\nint main(void) {\n struct rlimit limit; getrlimit(RLIMIT_NPROC, &limit);\n int pipes[2], count=0, failure=0; pid_t children[160]; pipe(pipes);\n for(int i=0;i<160;i++) {\n  pid_t child=fork();\n  if(child<0) { failure=errno; break; }\n  if(child==0) { char byte; close(pipes[1]); read(pipes[0],&byte,1); _exit(0); }\n  children[count++]=child;\n }\n close(pipes[1]); for(int i=0;i<count;i++) waitpid(children[i],0,0);\n printf(\"{\\\"guestNproc\\\":%lu,\\\"forked\\\":%d,\\\"errno\\\":%d}\\n\",limit.rlim_cur,count,failure);\n return 0;\n}\n",
      "note": "Uses the already installed compiler, bounded to 160 fork attempts; every successful child is reaped."
    }
  },
