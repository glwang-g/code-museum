{
  "name": "code-museum",
  "version": "0.1.0",
  "private": true,
  "description": "FreeXLib programming language exploration and experimentation — reproducible static site",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "dev": "node scripts/build.cjs && node scripts/serve.cjs",
    "preview": "node scripts/serve.cjs",
    "audit": "python3 scripts/audit-catalogue.py && python3 scripts/audit-integrity.py",
    "relations:audit": "node scripts/relationship-audit.cjs",
    "runtime:budget": "node scripts/runtime-budget.cjs",
    "runtime:browser": "node scripts/check-browser-runtime.cjs",
    "diagnose:release": "node scripts/diagnose-release.cjs",
    "executor:guest-browser": "node scripts/check-guest-browser.cjs",
    "executor:production-check": "node scripts/check-production-consistency.cjs",
    "research:gaps": "node scripts/research-gap-report.cjs",
    "research:coverage": "node scripts/research-coverage.cjs",
    "research:priorities": "node scripts/research-priorities.cjs",
    "test": "node --test tests/*.test.cjs",
    "executor:preview": "node scripts/executor-preview.cjs",
    "executor:check": "python3 scripts/check-executor.py",
    "executor:browser": "node scripts/check-executor-browser.cjs",
    "runtime:cli-build": "python3 scripts/build-cli-runtime.py",
    "runtime:cli-check": "python3 scripts/check-cli-runtimes.py",
    "runtime:cli-browser": "node scripts/check-executor-browser.cjs --cli",
    "mcp": "python3 server/mcp.py",
    "museum:browser": "node scripts/check-museum-advance.cjs",
    "performance:browser": "node scripts/check-performance.cjs",
    "runtime:pascal-r-build": "python3 scripts/build-pascal-r-runtime.py",
    "runtime:algol60-build": "python3 scripts/build-algol60-runtime.py",
    "runtime:common-lisp-build": "python3 scripts/build-common-lisp-runtime.py",
    "runtime:planned-check": "python3 scripts/check-planned-runtimes.py",
    "runtime:planned-browser": "node scripts/check-executor-browser.cjs --planned",
    "runtime:fixed-build": "python3 scripts/build-fixed-runtime.py",
    "executor:dual-preview": "node scripts/dual-executor-preview.cjs",
    "executor:dual-check": "node scripts/check-dual-executor.cjs",
    "executor:prepare-dual": "python3 deploy/prepare-dual-executor.py",
    "release:package": "node scripts/package-release.cjs",
    "lab:explanations-browser": "node scripts/check-lab-explanations.cjs",
    "lab:ai-preview": "node scripts/explanation-preview.cjs",
    "lab:ai-browser": "node scripts/check-ai-explanations.cjs",
    "controls:browser": "node scripts/check-control-activation.cjs",
    "credits:browser": "node scripts/check-credits-browser.cjs",
    "modern:preview": "npm run build && node scripts/preview-modern.cjs",
    "gallery:preview": "npm run build && node scripts/preview-gallery.cjs",
    "site:browser": "node scripts/check-full-gallery.cjs",
    "interface:browser": "node scripts/check-interface.cjs",
    "learning:browser": "node scripts/check-learning-flow.cjs",
    "platform:measure": "node scripts/measure-platform.cjs"
  }
}
