[Unit]
Description=Code Museum on-demand DeepSeek explanations
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=code-museum-explanation
Group=code-museum-explanation
WorkingDirectory=/opt/code-museum-explanation
EnvironmentFile=/etc/code-museum-explanation/private.env
ExecStart=/usr/bin/python3 /opt/code-museum-explanation/explanations.py --trusted-proxy
Restart=on-failure
RestartSec=3
StateDirectory=code-museum-explanation
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/code-museum-explanation
MemoryMax=192M
TasksMax=32

[Install]
WantedBy=multi-user.target
