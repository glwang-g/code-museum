# Runs on xshow; the dedicated xshow2 key is restricted to forwarding to worker 4181.
[Unit]
Description=Code Museum private tunnel to xshow2 worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=code-museum-tunnel
Group=code-museum-tunnel
EnvironmentFile=/etc/code-museum-executor/tunnel.env
LoadCredential=ssh-key:/etc/code-museum-executor/tunnel_ed25519
LoadCredential=ssh-known-hosts:/etc/code-museum-executor/tunnel_known_hosts
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=%d/ssh-known-hosts -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ConnectTimeout=10 -i %d/ssh-key -L 127.0.0.1:4183:127.0.0.1:4181 ${EXECUTOR_TUNNEL_TARGET}
Restart=always
RestartSec=5
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
